# Copy this file to .env and add at least ONE free API key below.

# === FREE OPTIONS (no credit card) — pick one or more ===

# Groq — FASTEST, ~1000 requests/day, best for Jarvis voice
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter — 50 free requests/day (1000/day after $10 top-up), 300+ models
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# NVIDIA NIM — 40 requests/min, no daily token cap
# Get key: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# GitHub Models — free if you have a GitHub account
# Get key: https://github.com/settings/tokens (or GitHub Models settings)
GITHUB_TOKEN=

# === PAID / LIMITED (optional) ===

# Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Gemini — limited free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fish Audio (optional voice) — https://fish.audio/
FISH_AUDIO_API_KEY=

# Which AI to use:
# auto | groq | openrouter | nvidia | claude | gemini
# "auto" tries free providers first: groq → openrouter → nvidia → claude → gemini
JARVIS_AI_PROVIDER=auto

# Assistant identity
JARVIS_NAME=Jarvis
JARVIS_USER_NAME=Ibrahim

# === Jarvis agent identity (DEFAULT for mail + browser sign-in) ===
# Create a dedicated Gmail for Jarvis. Enable 2SV → App passwords.
JARVIS_EMAIL=
JARVIS_PASSWORD=
# IMAP/SMTP App Password for Jarvis mail (NOT the normal login password)
JARVIS_APP_PASSWORD=
# Display name on outgoing mail (From: "Jarvis" <email>)
JARVIS_FROM_NAME=Jarvis

# === Your personal Gmail (optional — say "use my email") ===
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Where Jarvis emails Cursor / hunt reports (defaults to GMAIL_ADDRESS)
JARVIS_OWNER_EMAIL=

# Cursor SDK — full auto "give cursor a prompt in this folder…"
# https://cursor.com/settings → API keys
CURSOR_API_KEY=
CURSOR_AGENT_MODEL=composer-2.5

# Google Calendar / YouTube (Phase 2) — OAuth Desktop client
# Option A: download client JSON → data/google_credentials.json
# Option B: paste client id/secret here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable in Google Cloud: Calendar API + YouTube Data API v3
# Say: connect google calendar   OR   connect youtube

# Vision / screenshot paste (optional — Gemini preferred for OCR)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Voice settings
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_WAKE_WORD=jarvis

# Mira creative visual mode: auto (default) | legacy | neural_only
# auto = remote HF T2V when HF_TOKEN + huggingface_hub available; else labeled legacy collage
# legacy = force stock/still collage (never claims neural)
# neural_only = require remote neural (HF); fail honestly if unavailable
# MIRA_CREATIVE_VISUAL_MODE=auto

# Hugging Face Inference Providers — remote text-to-video (optional)
# Token needs "Make calls to Inference Providers" permission. Never commit secrets.
# HF_TOKEN=
# MIRA_HF_T2V_MODEL=Wan-AI/Wan2.1-T2V-1.3B
# MIRA_HF_T2V_PROVIDER=fal-ai
# MIRA_HF_T2V_NUM_FRAMES=25
# MIRA_HF_T2V_MAX_SCENES=2
# MIRA_HF_T2V_TIMEOUT_SEC=480
# MIRA_HF_T2V_STEPS=20
